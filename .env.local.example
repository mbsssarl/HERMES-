# Généré automatiquement par `npx convex dev` — ne pas renseigner à la main.
VITE_CONVEX_URL=

# Facultatif : identifiant client OAuth Google (type "Application Web") pour créer des brouillons Gmail avec pièce jointe.
# Origines JavaScript autorisées : l'adresse de l'app (ex. http://localhost:5173). Portée utilisée : gmail.compose.
VITE_GOOGLE_CLIENT_ID=
